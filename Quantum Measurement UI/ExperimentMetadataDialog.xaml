<Window x:Class="Quantum_measurement_UI.ExperimentMetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Experiment Metadata"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="640">
            <StackPanel>
                <TextBlock Text="Experiment metadata" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Filename" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox x:Name="FileNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" VerticalAlignment="Top" Margin="0,3,10,8"/>
                    <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Height="62" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Temp (K)" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox x:Name="TemperatureBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="On-sample power (mW)" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox x:Name="OnSamplePowerBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Laser wavelength (nm)" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox x:Name="LaserWavelengthBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Detector" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <ComboBox x:Name="DetectorComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Options" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                        <CheckBox x:Name="UsedOpoCheckBox" Content="Used OPO" Margin="0,0,0,5"/>
                        <CheckBox x:Name="AttenuatorCheckBox" Content="2 x 20 dB attenuator on Gage signal"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Samples" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <Border BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="3" Padding="8" Height="116">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SampleList"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Border BorderBrush="#B8B8B8" BorderThickness="1" CornerRadius="3" Padding="8" Height="116">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TagList"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="86" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Start" Width="86" IsDefault="True" Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
