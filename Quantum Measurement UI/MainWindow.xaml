<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Quantum_measurement_UI.MainWindow"
        Title="Quantum Measurement Software" Height="Auto" Width="1000" Margin="30" 
    Closing="MainWindow_Closing">

    <Grid Margin="0,0,0,-10">
        <!-- Define row definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <!-- Main content (TabControl) -->
            <RowDefinition Height="*" />
            <!-- Shared message box -->
        </Grid.RowDefinitions>

        <!-- TabControl for multiple pages -->
        <TabControl Grid.Row="0">
            <!-- Calibration Page -->
            <TabItem Header="Calibration">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <!-- Define columns: left controls + middle controls + charts -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Only one row needed here (full height) -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Left side: Motor controls (spans first two columns) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Vertical" Margin="10">

                            <!-- Manual Motion Control -->
                            <GroupBox Header="Manual Motion Control" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Select Motor:" />
                                    <ComboBox Name="MotorSelection" Width="100" SelectedIndex="0">
                                        <ComboBoxItem Content="Motor 1" />
                                        <ComboBoxItem Content="Motor 2" />
                                        <ComboBoxItem Content="Motor 3" />
                                    </ComboBox>

                                    <TextBlock Text="Relative Move (steps):" Margin="0,5,0,0" />
                                    <TextBox Name="RelativeSteps" Width="100" Text="0" />
                                    <Button Content="Move Relative" Width="150" Click="MoveRelativeButton_Click" Margin="0,5" />

                                    <Grid Margin="10,5,10,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Motor 1 buttons -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Label Content="Motor 1" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <Button Content="+10" Width="60" Margin="5" Click="MovePlus10_Click"/>
                                            <Button Content="-10" Width="60" Margin="5" Click="MoveMinus10_Click"/>
                                            <Button Content="+1" Width="60" Margin="5" Click="MovePlus1_Click"/>
                                            <Button Content="-1" Width="60" Margin="5" Click="MoveMinus1_Click"/>
                                        </StackPanel>

                                        <!-- Motor 2 buttons -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <Label Content="Motor 2" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <Button Content="+10" Width="60" Margin="5" Click="MovePlus10_Click_2"/>
                                            <Button Content="-10" Width="60" Margin="5" Click="MoveMinus10_Click_2"/>
                                            <Button Content="+1" Width="60" Margin="5" Click="MovePlus1_Click_2"/>
                                            <Button Content="-1" Width="60" Margin="5" Click="MoveMinus1_Click_2"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Position Target (steps):" Margin="0,5,0,0" />
                                    <TextBox Name="PositionTarget" Width="100" Text="0" />
                                    <Button Content="Move to Target" Width="150" Click="MoveToTargetButton_Click" Margin="0,5" />

                                    <Button Content="Set Zero Position" Width="150" Click="SetZeroPositionButton_Click" Margin="0,5" />

                                    <TextBlock Text="Current Position1:" Margin="0,5,0,0" />
                                    <TextBox Name="CalibrationMotor1Pos" Width="100" IsReadOnly="True" />

                                    <TextBlock Text="Current Position2:" Margin="0,5,0,0" />
                                    <TextBox Name="CalibrationMotor2Pos" Width="100" IsReadOnly="True" />

                                    <TextBlock Text="Sensitivity (urad²/√Hz):" Margin="0,5,0,0" />
                                    <TextBox Name="sensitivityEval" Width="100" IsReadOnly="True" />

                                    <TextBlock Text="Power diff (Ch1):" Margin="0,5,0,0" />
                                    <TextBox Name="PowerDiffCh1" Width="100" IsReadOnly="True" />

                                    <TextBlock Text="Power diff (Ch2):" Margin="0,5,0,0" />
                                    <TextBox Name="PowerDiffCh2" Width="100" IsReadOnly="True" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Automatic Continuous Motion Control -->
                            <GroupBox Header="Automatic Continuous Motion Control">
                                <StackPanel>
                                    <TextBlock Text="Time per Move (ms):" Margin="0,5,0,0" />
                                    <TextBox Name="TimePerMove" Width="100" Text="200" />

                                    <TextBlock Text="Steps per Move:" Margin="0,5,0,0" />
                                    <TextBox Name="StepsPerMove" Width="100" Text="5" />

                                    <TextBlock Text="Total Number of Moves:" Margin="0,5,0,0" />
                                    <TextBox Name="TotalNumberOfMoves" Width="100" Text="10" />

                                    <Button Content="Start Motion" Width="150" Click="StartMotionButton_Click" Margin="0,10,0,5"/>
                                    <Button Content="Stop Motion"  Width="150" Click="StopMotionButton_Click"  Margin="0,5"/>
                                </StackPanel>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <Button Name="StartAlignmentButton" 
            Content="Start Alignment" 
            Width="110" Height="30" Margin="0,0,10,0"
            Click="StartAlignmentButton_Click"
            Background="LightGray"
            FontWeight="Bold"/>

                                <Button Name="StopAlignmentButton" 
            Content="Stop Alignment" 
            Width="110" Height="30" 
            Click="StopAlignmentButton_Click"
            Background="LightGray"
            FontWeight="Bold"
            IsEnabled="False"/>
                            </StackPanel>


                            <GroupBox Header="Integrated Column Data (Indices 1,9,17...57)" Margin="10">
                                <StackPanel>
                                    <!-- Header row: left = stats, right = reset button -->
                                    <Grid Margin="5,0,5,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Name="IntegralRejectionStatsText" 
                                                   Text="Rejection Rate: 0 / 0 (0.00%)" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" 
                                                   Foreground="DarkRed"
                                                   Margin="0,0,10,0"/>

                                        <Button Grid.Column="1"
                                                Name="ResetIntegralButton"
                                                Content="Reset Integral Data" 
                                                MinWidth="140" Height="26"
                                                Padding="10,0"
                                                HorizontalAlignment="Right"
                                                Click="ResetIntegralChart_Click"
                                                Background="#FFF0F0"
                                                FontWeight="Bold"/>
                                    </Grid>

                                    <oxy:PlotView x:Name="IntegralPlotView"
                                                  Height="200" />
                                </StackPanel>
                            </GroupBox>

                            <!-- Logo -->
                            <Image Source="Images/Rice-EQUAL-Lab-Logo.png"
                       Width="156" Height="91"
                       RenderTransformOrigin="0.49,0.455"
                       Stretch="UniformToFill"
                       Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- Middle column: Configuration, Commands, Status, Metadata -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="10">

                            <!-- Experiment Configuration -->
                            <GroupBox Header="Experiment Configuration" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="External Clock (ExtClk):" Margin="0,5,0,0" />
                                    <TextBox Name="ExtClkTextBox" Width="100" Text="1" />

                                    <TextBlock Text="Time Counter (TimeCounter):" Margin="0,5,0,0" />
                                    <TextBox Name="TimeCounterTextBox" Width="100" Text="100000000" />

                                    <TextBlock Text="Delay Stage Program:" Margin="0,10,0,0" />
                                    <ComboBox Name="DelayStageProgram" Width="100" IsEditable="True" Text="Stay">
                                        <ComboBoxItem Content="Scan05" />
                                        <ComboBoxItem Content="Scan1" />
                                        <ComboBoxItem Content="Scan5" />
                                        <ComboBoxItem Content="Scan10" />
                                        <ComboBoxItem Content="Scan20" />
                                        <ComboBoxItem Content="Scan30" />
                                        <ComboBoxItem Content="Scan40" />
                                        <ComboBoxItem Content="Stay" />
                                    </ComboBox>
                                    <TextBlock Text="(Name of program to execute)" FontSize="9" Foreground="Gray" Margin="0,2,0,0" />

                                    <Button Content="Apply" Width="120" Click="ApplyConfigButton_Click" Margin="0,10,0,5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Experiment Commands -->
                            <GroupBox Header="Experiment Commands" Margin="0,10,0,0">
                                <StackPanel Margin="10">
                                    <Button Name="StartButton" Content="Start" Width="120" HorizontalAlignment="Center"
                                Margin="0,10,0,5" Click="StartButton_Click"/>
                                    <Button Name="TerminateButton" Content="Terminate" Width="120" HorizontalAlignment="Center"
                                Margin="0,5,0,10" Click="TerminateButton_Click"/>
                                    <Button Name="ResendDelayStageProgramButton" Content="Resend ESP Program" Width="150" HorizontalAlignment="Center"
                                Margin="0,0,0,10" Click="ResendDelayStageProgramButton_Click"
                                ToolTip="Sends the selected delay-stage program command again without restarting acquisition."/>
                                    <CheckBox x:Name="EnableFFTCheckBox" Content="Enable FFT" IsChecked="False"
                                  Margin="8,0,0,0"
                                  Checked="EnableFFTCheckBox_Checked"
                                  Unchecked="EnableFFTCheckBox_Unchecked"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Home Zero -->
                            <GroupBox Header="Home Zero" Margin="0,10,0,0">
                                <StackPanel Orientation="Vertical" Margin="8" VerticalAlignment="Center">
                                    <TextBlock Text="Time 0 position:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Name="TimeZeroPositionInput" Width="100" Text="25"
                                 KeyDown="TimeZeroPositionInput_KeyDown"
                                 TextChanged="TextBox_TextChanged" Margin="0,0,0,8"/>
                                    <Button Content="Go to Time 0" Width="130" Click="GoToTimeZero_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Delay Stage Status -->
                            <GroupBox Header="Delay Stage" Margin="0,10,0,0">
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Position:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Name="DelayStagePositionText" Text="0.00000" VerticalAlignment="Center"/>
                                            <TextBlock Text=" mm" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Status:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <Ellipse Name="DelayStageStatusIndicator" Width="15" Height="15" Fill="Red" Margin="5,0,0,0"/>
                                            <TextBlock Name="DelayStageStatusText" Text="Off" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Name="ResetDelayStageButton" Content="Reset" Width="120" Margin="0,10,0,5"
                                Click="ResetDelayStageButton_Click"
                                ToolTip="Resets the ESP300 controller - may take 20 seconds to complete"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Experiment Status -->
                            <GroupBox Header="Experiment Status" Margin="0,10,0,0">
                                <StackPanel Orientation="Vertical" Margin="10">
                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Experiment:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <Ellipse Name="ExperimentStatusIndicator" Width="15" Height="15" Fill="Red" Margin="5,0,0,0"/>
                                            <TextBlock Name="ExperimentStatusText" Text="Off" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="External Clock:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <Ellipse Name="ExtClkStatusIndicator" Width="15" Height="15" Fill="Red" Margin="5,0,0,0"/>
                                            <TextBlock Name="ExtClkStatusText" Text="Off" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Elapsed Time:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Name="ElapsedTimeText" Grid.Column="1" Text="00:00:00" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Log File Metadata -->
                            <GroupBox Header="Log File Metadata" Margin="0,10,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Filename:" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Name="FileNameInput" Width="100" Text="test.txt"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Description:" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Name="DescriptionInput" Width="150" Text="Testing run"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Temp (K):" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Name="TemperatureInput" Width="100" Text="294"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="On Sample Power:" Width="70" VerticalAlignment="Center"/>
                                        <TextBox Name="OnSamplePowerInput" Width="100" Text=""/>
                                        <TextBlock Text="mW" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Attenuator:" Width="70" VerticalAlignment="Center"/>
                                        <CheckBox Name="PowerDetectorAttenuatorAppliedCheckBox"
                                                  Content="2 x 10 dB on Gage signal"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Label Content="Select Sample(s):" FontWeight="Bold" Margin="0,5,0,0"/>
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Height="80" Margin="5">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="SampleCheckBoxList" Margin="5">
                                                <CheckBox Content="Sm0.7Er0.3FeO3 (50 um)" Margin="0,2"/>
                                                <CheckBox Content="Vacuum" Margin="0,2"/>
                                                <CheckBox Content="ErFeO3" Margin="0,2"/>
                                                <CheckBox Content="Calibration Source" Margin="0,2"/>
                                                <CheckBox Content="Unknown Sample" Margin="0,2"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <Label Content="Experiment Tags:" FontWeight="Bold" Margin="0,5,0,0"/>
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Height="80" Margin="5">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="MetadataCheckBoxList" Margin="5">
                                                <CheckBox Content="Squeezing" Margin="0,2"/>
                                                <CheckBox Content="Anti-Squeezing" Margin="0,2"/>
                                                <CheckBox Content="Shot Noise" Margin="0,2"/>
                                                <CheckBox Content="Dark Noise" Margin="0,2"/>
                                                <CheckBox Content="Alignment" Margin="0,2"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Right side: Charts -->
                        <Grid Grid.Row="0" Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*" />
                                <!-- bigger top chart -->
                                <RowDefinition Height="1.2*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0.8*" />
                            </Grid.RowDefinitions>

                            <!-- Signal Chart (top) -->
                            <oxy:PlotView x:Name="SignalPlotView"
                                          Grid.Row="0"
                                          Margin="10" />

                            <!-- Heatmap Chart (middle) -->
                            <oxy:PlotView x:Name="HeatmapPlotView"
                                          Grid.Row="1"
                                          Margin="10" />

                            <!-- Matrix Balance Chart (bottom) + overlaid text -->
                            <GroupBox Header="Matrix Balance - Trend Analysis" Grid.Row="2" Margin="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="400"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="5">
                                        <DataGrid Name="MatrixBalanceTable" 
                      ItemsSource="{Binding MatrixTableData}" 
                      SelectionMode="Extended" 
                      SelectionUnit="FullRow"
                      SelectionChanged="MatrixBalanceTable_SelectionChanged"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Height="250"
                      VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pair" Binding="{Binding Channel}" Width="40"/>
                                                <DataGridTextColumn Header="Raw (V²)" Binding="{Binding Value, StringFormat=\{0:E2\}}" Width="85"/>
                                                <DataGridTextColumn Header="Signal (μrad²)" Binding="{Binding PhysicalValue, StringFormat=\{0:F2\}}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="DarkBlue"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Background="#F0F0F0" CornerRadius="5" Margin="0,10,0,0" Padding="5">
                                            <StackPanel>
                                                <TextBlock Name="SkippedFramesText" 
                               Text="Processed: 0 | Backend FPS: 0.00 | Display FPS: 0.00" 
                               FontSize="11" 
                               Margin="2"/>

                                                <TextBlock Name="SelectedAccumulationText"
                               Text="Selected accumulation: none"
                               FontSize="11" 
                               Margin="2"/>

                                                <Button Content="Reset Matrix  Lock New Factor" 
                            Click="ResetMatrixBalanceChart_Click" 
                            Height="30" 
                            Margin="0,5,0,0"
                            Background="#FFF0F0"
                            FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <GroupBox Header="Selected Channel Correlation vs ESP Position" Grid.Column="1" Margin="5,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,8">
                                                <TextBlock Text="Y Min:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Name="SelectedTrendYMinTextBox"
                                                         Width="70"
                                                         Text="-10"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,12,0"/>
                                                <TextBlock Text="Y Max:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Name="SelectedTrendYMaxTextBox"
                                                         Width="70"
                                                         Text="10"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,12,0"/>
                                                <Button Content="Apply Scale"
                                                        Width="90"
                                                        Height="24"
                                                        Margin="0,0,8,0"
                                                        Click="ApplySelectedTrendScale_Click"/>
                                                <Button Content="Auto"
                                                        Width="60"
                                                        Height="24"
                                                        Click="AutoScaleSelectedTrend_Click"/>
                                            </StackPanel>

                                            <oxy:PlotView x:Name="SelectedTrendPlotView"
                                                          Grid.Row="1" />
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </GroupBox>



                            <GroupBox Header="Selected Channel Cumulative Average At Current Position" Grid.Row="3" Margin="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Name="SelectedPositionAverageText"
                                               Grid.Row="0"
                                               Text="Single-position cumulative average: none"
                                               FontSize="11"
                                               Margin="6,4,6,8"/>

                                    <oxy:PlotView x:Name="SelectedPositionAveragePlotView"
                                                  Grid.Row="1" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Autobalance Page -->
            <TabItem Header="Autobalance" Margin="-2,-3,-2,1">
                <ScrollViewer>
                    <Grid>
                        <!-- Define columns -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="166"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Define rows -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Left Control Panel -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,10,10,10" Grid.ColumnSpan="2">
                            <!-- Autobalance Control Panel -->
                            <GroupBox Header="Autobalance Control">
                                <StackPanel>
                                    <!-- Threshold Input -->
                                    <TextBlock Text="Threshold:" Margin="0,10,0,0"/>
                                    <TextBox Name="ThresholdInput" Width="100" Text="0" />
                                    <TextBlock Text="Number of Segments:" Margin="0,10,0,0"/>
                                    <TextBox Name="NumSegments" Width="100" Text="4"/>

                                    <!-- Start Autobalance Button -->
                                    <Button Content="Start" Width="150" Click="StartAutobalanceButton_Click" Margin="0,5,0,5"/>
                                    <Button Content="Terminate" Width="150" Click="TerminateAutobalanceButton_Click" Margin="0,5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Additional controls if necessary -->
                        </StackPanel>

                        <!-- Right Side Charts -->
                        <Grid Grid.Row="1" Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- SignalChartAutobalance -->
                            <lvc:CartesianChart Name="SignalChartAutobalance"
                                            LegendLocation="Bottom"
                                            Grid.Row="0" Margin="10">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Sample Index"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Signal Amplitude (mV)"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>

                            <!-- MotorPositionChart -->
                            <lvc:CartesianChart Name="MotorPositionChart"
                                            Grid.Row="1" Margin="10">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Steps"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Motor Position"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>

                            <!-- FlatnessChart -->
                            <lvc:CartesianChart Name="FlatnessChart"
                                            Grid.Row="2" Margin="10">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Steps"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Flatness Metric"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ESP Position">
                <ScrollViewer>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Controls Column -->
                            <ColumnDefinition Width="*" />
                            <!-- Chart Column -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Controls -->
                        <StackPanel Orientation="Vertical" Grid.Column="0" Margin="0,0,20,0">

                            <!-- Group 1: Motion Settings -->
                            <GroupBox Header="Motion Settings" Margin="0,0,0,10">
                                <StackPanel Margin="10">

                                    <TextBlock Text="Velocity (VA)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="VAInput" Width="100"/>

                                    <TextBlock Text="Velocity Limit (VU)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="VUInput" Width="100"/>

                                    <TextBlock Text="Acceleration (AC)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="ACInput" Width="100"/>

                                    <TextBlock Text="Max Acc/Dec (AU)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="AUInput" Width="100"/>

                                    <TextBlock Text="Deceleration (AG)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="AGInput" Width="100"/>

                                    <Button Content="Apply Motion Settings" Width="150" Margin="0,10,0,0" Click="ApplyMotionSettings_Click"/>
                                    <Button Content="Read Current Motion Settings" Width="150" Margin="0,5,0,0" Click="ReadMotionSettings_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 2: Basic Commands -->
                            <GroupBox Header="Basic Commands" Margin="0,0,0,10">
                                <StackPanel Margin="10">

                                    <Button Content="Stop Motion" Width="150" Margin="0,5,0,0" Click="ESP_StopMotion_Click"/>
                                    <Button Content="Abort Program" Width="150" Margin="0,5,0,0" Click="ESP_AbortProgram_Click"/>
                                    <Button Content="Reset Controller" Width="150" Margin="0,5,0,0" Click="ESP_ResetController_Click"/>
                                    <Button x:Name="EnableMotorButton" Content="Enable Motor" Click="EnableMotorButton_Click" Width="120" Height="30" Margin="5"/>

                                    <TextBlock Text="Move to Absolute Position (PA)" Margin="0,10,0,0"/>
                                    <TextBox x:Name="PAInput" Width="100"/>
                                    <Button Content="Move to Position" Width="150" Margin="0,5,0,0" Click="ESP_MoveToPosition_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Group 3: Auto Cycle Program -->
                            <GroupBox Header="Auto ESP Cycle Program">
                                <StackPanel Margin="10">

                                    <TextBlock Text="Center Point (mm)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="CenterPointInput" Width="100" Text="24.4"/>

                                    <TextBlock Text="Span (mm)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="SpanInput" Width="100" Text="5"/>

                                    <TextBlock Text="Step Size (mm)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="StepSizeInput" Width="100" Text="0.001"/>

                                    <TextBlock Text="Loop Count" Margin="0,5,0,0"/>
                                    <TextBox x:Name="LoopCountInput" Width="100" Text="10"/>

                                    <TextBlock Text="Dwell Time (s)" Margin="0,5,0,0"/>
                                    <TextBox x:Name="DwellTimeInput" Width="100" Text="60"/>

                                    <Button Content="Run stepwise Cycle" Width="150" Margin="0,10,0,0" Click="RunAutoCycle_Click"/>
                                    <Button Content="Abort Cycle" Width="150" Margin="0,10,0,0" Click="StopAutoCycle_Click"/>


                                </StackPanel>
                            </GroupBox>

                        </StackPanel>

                        <!-- Right Panel: ESP Position Chart and Update Controls -->
                        <StackPanel Grid.Column="1" Orientation="Vertical">

                            <lvc:CartesianChart x:Name="ESPPositionChart"
                        Height="500" Margin="0"
                        LegendLocation="Right">
                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries Title="ESP Position"
                            PointGeometrySize="5"
                            StrokeThickness="2"
                            Fill="Transparent"/>
                                </lvc:CartesianChart.Series>
                            </lvc:CartesianChart>

                            <!-- Controls row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button x:Name="RunStoredProgramButton"
                Content="Run Program 10"
                Width="150" Height="30" Margin="5"
                Click="RunStoredProgramButton_Click"/>
                                <Button x:Name="RunStoredProgram1Button"
                Content="Run Program 1"
                Width="150" Height="30" Margin="5"
                Click="RunStoredProgram1Button_Click"/>
                                <Button x:Name="ResendDelayStageProgramButtonEspPage"
                Content="Resend Selected Program"
                Width="180" Height="30" Margin="5"
                Click="ResendDelayStageProgramButton_Click"
                ToolTip="Sends the selected delay-stage program command again without restarting acquisition."/>
                            </StackPanel>

                            <!-- Time counter row in a border -->
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="Elapsed: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="AutoScanElapsedText" Text="00:00:00" Width="80" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <TextBlock Text="Remaining: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="AutoScanRemainingText" Text="00:00:00" Width="80" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>



                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="NIDaq Plot">
                <ScrollViewer >
                    <Grid Margin="10">
                        <StackPanel Orientation="Vertical">

                            <!-- DAQ Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <Button x:Name="ConnectDAQButton" Content="Connect DAQ Service" Width="150" Height="40" Margin="5" Click="ConnectDAQButton_Click"/>
                                <Button Content="Release DAQ Pipe" Width="150" Height="30" Margin="5" Click="ReleaseDAQPipeButton_Click" />
                                <Button x:Name="StartDAQButton" Content="Start DAQ" Width="100" Height="40" Margin="5" Click="StartDAQButton_Click"/>
                                <Button x:Name="StopDAQButton" Content="Stop DAQ" Width="100" Height="40" Margin="5" Click="StopDAQButton_Click"/>
                                <Button Content="Save AI5 to CSV" Width="150" Height="30" Margin="5" Click="SaveAI5DataToCSV_Click" />
                                <Button Content="Start/Stop MotorVsAI5 Auto-Log" Click="ToggleMotorVsAI5AutoLog_Click" Width="250" Height="30" Margin="5"/>
                            </StackPanel>

                            <!-- DAQ Chart and Channel Toggles -->
                            <TextBlock x:Name="DaqRefreshStatusText"
                                       Text="Display refresh: stopped"
                                       FontWeight="SemiBold"
                                       Margin="14,0,10,0"/>
                            <oxy:PlotView x:Name="DAQPlotView"
                                          Height="400"
                                          Margin="10"/>

                            <WrapPanel Orientation="Horizontal" Margin="10,0,10,10">
                                <CheckBox Content="AI0" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="0" Margin="5"/>
                                <CheckBox Content="AI1" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="1" Margin="5"/>
                                <CheckBox Content="AI2" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="2" Margin="5"/>
                                <CheckBox Content="AI3" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="3" Margin="5"/>
                                <CheckBox Content="AI4" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="4" Margin="5"/>
                                <CheckBox Content="AI5" IsChecked="True" Checked="ChannelToggle_Checked" Unchecked="ChannelToggle_Unchecked" Tag="5" Margin="5"/>
                            </WrapPanel>

                            <!-- AI monitor -->
                            <TextBlock Text="Rolling mean voltage, refreshed every 0.1 s"
                                       FontWeight="SemiBold"
                                       Margin="14,4,10,0"/>
                            <oxy:PlotView x:Name="AITimeSeriesPlotView"
                                          Height="400"
                                          Margin="10"/>

                            <!-- Motor vs AI5 -->
                            <lvc:CartesianChart x:Name="MotorVsAI5Chart" Height="400" Margin="10">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="ESP Position (mm)" />
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="AI5 Amplitude (V)" />
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Statistics">
                <ScrollViewer>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <!-- Time Series Chart -->
                            <RowDefinition Height="*" />
                            <!-- Stats Table -->
                            <RowDefinition Height="Auto"/>
                            <!-- Shot Noise Info -->
                        </Grid.RowDefinitions>

                        <!-- =================== AI5 Stats Table =================== -->
                        <DataGrid x:Name="AI5StatsTable"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      FontSize="14"
                      Margin="10"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Channel" Width="*" />
                                <DataGridTextColumn Header="Mean (V)" Width="*" />
                                <DataGridTextColumn Header="Std Dev (V)" Width="*" />
                                <DataGridTextColumn Header="Min (V)" Width="*" />
                                <DataGridTextColumn Header="Max (V)" Width="*" />
                                <DataGridTextColumn Header="Power (mW)" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- =================== Shot Noise Info =================== -->
                        <StackPanel Grid.Row="2" Margin="10">
                            <TextBlock x:Name="CurrentSensitivityTextBlock"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,5"
                           Text="Shot Noise: N/A"/>

                            <TextBlock x:Name="ConversionFactorTextBlock"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="LightGray"
                           Margin="0,0,0,10"
                           Text="Conversion Factor: N/A" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>


            <!--Alternate Tab for the Message Box-->
            <!--<TabItem Header="Messages">
                <Grid>
                    <TextBox Name="SharedMessageLog"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12" />
                </Grid>
            </TabItem>-->
            <TabItem Header="Experiment History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="HistorySearchBox" Width="200" TextChanged="HistorySearchBox_TextChanged"/>
                        <Button Content="Refresh List" Width="100" Margin="10,0,0,0" Click="RefreshHistory_Click"/>
                        <Button Content="Open Folder" Width="100" Margin="10,0,0,0" Click="OpenSelectedFolder_Click"/>
                        <Button Content="Open LogLog" Width="100" Margin="10,0,0,0" Click="OpenSelectedLoglogEval_Click"/>
                        <Button Content="Open Diagonal" Width="110" Margin="10,0,0,0" Click="OpenSelectedDiagonalOffset_Click"/>
                        <Button Content="Open FFT" Width="90" Margin="10,0,0,0" Click="OpenSelectedFftSpectrum_Click"/>
                        <Button Content="Open Raw Std" Width="110" Margin="10,0,0,0" Click="OpenSelectedRawStd_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="HistoryGrid" 
          Grid.Row="1" 
          AutoGenerateColumns="False" 
          IsReadOnly="True"
          SelectionMode="Single" 
          SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding SortableDate, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>

                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>

                            <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" Width="150"/>

                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>

                            <DataGridTextColumn Header="Shot Noise" Binding="{Binding ShotNoiseDisplay}" Width="150"/>

                            <DataGridTextColumn Header="Power (mW)" Binding="{Binding TotalPower, StringFormat=N2}" Width="80"/>

                            <DataGridTextColumn Header="Range (mm)" Binding="{Binding ScanRange, StringFormat=N3}" Width="90"/>

                            <DataGridTextColumn Header="Center (mm)" Binding="{Binding CenterPosition, StringFormat=N2}" Width="80"/>

                            <DataGridTextColumn Header="Motors" Binding="{Binding MotorPositions}" Width="120"/>

                            <DataGridTextColumn Header="Tags" Binding="{Binding TagsDisplay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- Additional tabs can be added here -->
        </TabControl>


        <!--Shared Message Box at the bottom-->
        <GroupBox Header="Messages" Grid.Row="1" Margin="10">
            <Grid>
                <ScrollViewer>
                    <TextBox Name="SharedMessageLog"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="12" />
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>

    <!--UI Elements-->
    <Window.Resources>
        <Style TargetType="TabControl">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"></Setter>
                    <Setter Property="BorderThickness" Value="5"></Setter>
                </Style>
            </Style.Resources>
        </Style>


        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"></Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="GroupBox">


            <Style.Resources>
                <Style TargetType="Border">

                    <Setter Property="CornerRadius" Value="20"></Setter>

                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"></Setter>
        </Style>
    </Window.Resources>
</Window>
